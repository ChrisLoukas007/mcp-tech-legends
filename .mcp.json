{
  "mcpServers": {
    "figures-db": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "figures-db-mcp"
      ],
      "env": {
        "FIGURES_DB_MCP_DATABASE_URL": "postgresql://figures_reader:${FIGURES_READER_PASSWORD}@localhost:5433/legends",
        "FIGURES_DB_MCP_STDIO_SCOPES": "[\"figures:read\"]"
      }
    },
    "wiki": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "wiki-mcp"
      ],
      "env": {
        "WIKI_MCP_STDIO_SCOPES": "[\"wiki:read\"]"
      }
    },
    "hall-of-fame": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "hall-of-fame-mcp"
      ],
      "env": {
        "HALL_OF_FAME_MCP_CLIENT_SECRET": "${HALL_OF_FAME_MCP_CLIENT_SECRET}",
        "HALL_OF_FAME_MCP_STDIO_SUBJECT": "ada",
        "HALL_OF_FAME_MCP_STDIO_SCOPES": "[\"halloffame:read\",\"halloffame:write\"]",
        "HALL_OF_FAME_MCP_STDIO_ROLES": "[\"legends-viewer\",\"legends-curator\"]"
      }
    }
  }
}
