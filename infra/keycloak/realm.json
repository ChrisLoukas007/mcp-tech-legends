{
  "realm": "legends",
  "displayName": "Tech Legends (local development only)",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "legends-viewer", "description": "May read collections and notes" },
      { "name": "legends-curator", "description": "May also create collections and notes" }
    ]
  },
  "defaultDefaultClientScopes": [],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        { "name": "sub", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" } },
        { "name": "username", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-property-mapper",
          "config": { "user.attribute": "username", "claim.name": "preferred_username", "jsonType.label": "String",
                      "access.token.claim": "true", "id.token.claim": "true", "introspection.token.claim": "true" } }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        { "name": "realm roles", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "realm_access.roles", "multivalued": "true", "jsonType.label": "String",
                      "access.token.claim": "true", "introspection.token.claim": "true" } }
      ]
    },
    {
      "name": "figures:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        { "name": "aud figures-db-mcp", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "figures-db-mcp", "access.token.claim": "true",
                      "introspection.token.claim": "true" } }
      ]
    },
    {
      "name": "wiki:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        { "name": "aud wiki-mcp", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "wiki-mcp", "access.token.claim": "true",
                      "introspection.token.claim": "true" } }
      ]
    },
    {
      "name": "halloffame:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        { "name": "aud hall-of-fame-mcp", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "hall-of-fame-mcp", "access.token.claim": "true",
                      "introspection.token.claim": "true" } }
      ]
    },
    {
      "name": "halloffame:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        { "name": "aud hall-of-fame-mcp", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "hall-of-fame-mcp", "access.token.claim": "true",
                      "introspection.token.claim": "true" } }
      ]
    },
    {
      "name": "hall-of-fame-api:call",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        { "name": "aud hall-of-fame-api", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "hall-of-fame-api", "access.token.claim": "true",
                      "introspection.token.claim": "true" } }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "agent-cli",
      "name": "agent-cli (custom MCP host)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://127.0.0.1:8765/callback"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+" },
      "defaultClientScopes": ["basic", "roles"],
      "optionalClientScopes": ["figures:read", "wiki:read", "halloffame:read", "halloffame:write"]
    },
    {
      "clientId": "agent-cli-test",
      "name": "agent-cli for automated tests (password grant, local only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-agent-cli-test-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": ["basic", "roles"],
      "optionalClientScopes": ["figures:read", "wiki:read", "halloffame:read", "halloffame:write"]
    },
    {
      "clientId": "hall-of-fame-mcp",
      "name": "hall-of-fame-mcp (service account calling the private API)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-hall-of-fame-mcp-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["basic", "hall-of-fame-api:call"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "ada", "enabled": true, "emailVerified": true,
      "firstName": "Ada", "lastName": "Curator", "email": "ada@example.test",
      "credentials": [{ "type": "password", "value": "dev-only-ada", "temporary": false }],
      "realmRoles": ["legends-viewer", "legends-curator"]
    },
    {
      "username": "linus", "enabled": true, "emailVerified": true,
      "firstName": "Linus", "lastName": "Viewer", "email": "linus@example.test",
      "credentials": [{ "type": "password", "value": "dev-only-linus", "temporary": false }],
      "realmRoles": ["legends-viewer"]
    },
    {
      "username": "service-account-hall-of-fame-mcp", "enabled": true,
      "serviceAccountClientId": "hall-of-fame-mcp",
      "realmRoles": []
    }
  ]
}
