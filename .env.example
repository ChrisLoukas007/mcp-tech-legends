# Copy to .env (make env) and change the values. Local stack only; production secrets
# come from a secret manager.
POSTGRES_PASSWORD=change-me-postgres
FIGURES_READER_PASSWORD=change-me-figures
HALLOFFAME_APP_PASSWORD=change-me-halloffame
AUDIT_WRITER_PASSWORD=change-me-audit
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak

# Keycloak client secret of hall-of-fame-mcp (matches infra/keycloak/realm.json, local only)
HALL_OF_FAME_MCP_CLIENT_SECRET=dev-only-hall-of-fame-mcp-secret
